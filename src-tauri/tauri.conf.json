{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bentomux",
  "version": "0.2.37",
  "identifier": "app.bentomux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run prepare:cloudflared",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/renderer"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/bentomux-hook.cjs",
      "../resources/remote-page.html",
      "../resources/manifests",
      "../resources/cloudflared",
      "../resources/plugin-templates",
      "../resources/plugin-bundled",
      "../resources/plugin-skill",
      "../resources/plugin-sdk",
      "../resources/plugin-schema.json"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMjhGRkUzNkExNTY4NjcKUldSbmFCVnE0LzhvZmZXNVR0aFMyUW9ybG5Vd1RaaFZkL25WUENuRExwdFJhaWRCUlBFd0RObzEK",
      "endpoints": [
        "https://github.com/takora-dev/bentomux-v2/releases/latest/download/updater.json"
      ]
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Bentomux",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false
      },
      {
        "label": "approval-overlay",
        "title": "Bentomux ??? approval",
        "url": "approval.html",
        "width": 480,
        "height": 220,
        "minWidth": 480,
        "minHeight": 220,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' plugin: http://plugin.localhost; style-src 'self' 'unsafe-inline' plugin: http://plugin.localhost; img-src 'self' data: blob: plugin: http://plugin.localhost; font-src 'self' data: plugin: http://plugin.localhost; connect-src 'self' ipc: http://ipc.localhost plugin: http://plugin.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: ws://localhost:5173 http://localhost:5173 plugin: http://plugin.localhost ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  }
}
