{
  "name": "bentomux-v2",
  "productName": "Bentomux",
  "version": "0.2.37",
  "description": "Bentomux - calm desktop for AI agent runtime workspaces (Tauri)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "measure:build": "node scripts/measure-build.mjs",
    "prepare:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:backend": "node scripts/test-backend.mjs",
    "check:remote-page": "node scripts/check-remote-page.mjs",
    "check:csp-inline-styles": "node scripts/check-csp-inline-styles.mjs",
    "test:release": "node scripts/release-manifest.mjs --selftest",
    "test:installer": "sh scripts/verify-installer.sh",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "plugin:templates": "node scripts/gen-plugin-templates.mjs",
    "plugin:check": "node scripts/check-plugin-templates.mjs",
    "plugin:skill": "node scripts/gen-plugin-skill.mjs",
    "plugin:skill:check": "node scripts/gen-plugin-skill.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.0"
  }
}
